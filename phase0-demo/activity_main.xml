<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="dyrpa Phase 0 demo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="验证 Shizuku/Stellar + 心跳保活"
            android:textSize="14sp"
            android:textColor="#666"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/btnReqShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 请求 Shizuku 权限"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTestTap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. 测试 input tap (500, 500)"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://your.server:8080/heartbeat"
            android:inputType="textUri"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnStartHb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. 启动心跳服务"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnStopHb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. 停止心跳"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:text="状态..."/>
    </LinearLayout>
</ScrollView>
